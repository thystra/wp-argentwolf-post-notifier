{
  "name": "argentwolf-post-notifier",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Development tooling for ArgentWolf Post Notifier.",
  "type": "module",
  "scripts": {
    "build": "wp-scripts build --config webpack.config.cjs",
    "start": "wp-scripts start --config webpack.config.cjs",
    "lint:js": "wp-scripts lint-js assets/src tests/js webpack.config.cjs",
    "lint:css": "wp-scripts lint-style \"assets/src/**/*.scss\"",
    "lint:md": "wp-scripts lint-md-docs AGENTS.md ARCHITECTURE.md CHANGELOG.md README.md TODO.md",
    "test:js": "wp-scripts test-unit-js",
    "check:engines": "wp-scripts check-engines",
    "format": "wp-scripts format assets/src tests/js webpack.config.cjs"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0",
    "npm": ">=10.2.3"
  }
}
